{
  "schemaVersion": 1,
  "id": "drop",
  "name": "Drop",
  "version": "0.3.0",
  "description": "局域网速传：扫码即连，拖拽传文件、发文字、预览与打包下载",
  "category": "文件传输",
  "icon": "media",
  "tone": "orange",
  "kind": "app",
  "capabilities": [
    "web",
    "server"
  ],
  "server": {
    "backend": {
      "type": "node",
      "entry": "server.mjs"
    },
    "readyTimeoutMs": 8000
  },
  "web": {
    "url": "http://127.0.0.1:{{port}}"
  }
}
