{
  "schemaVersion": 1,
  "id": "drop",
  "name": "Drop",
  "version": "0.1.0",
  "description": "手机与电脑之间的局域网文件速传：扫码即连，拖拽即传",
  "category": "文件传输",
  "icon": "git",
  "tone": "blue",
  "kind": "app",
  "capabilities": ["web", "server"],
  "server": {
    "backend": {
      "type": "node",
      "entry": "server.mjs"
    },
    "readyTimeoutMs": 8000
  },
  "web": {
    "url": "http://127.0.0.1:{{port}}"
  }
}
